<?php

namespace {{namespace}}\Infrastructure\Repositories;

use {{namespace}}\Domain\Interfaces\{{feature}}GetInterface;
use {{namespace}}\Domain\Interfaces\{{feature}}PostInterface;
use {{namespace}}\Infrastructure\Eloquent\Model{{feature}};

class {{feature}}Repository implements {{feature}}GetInterface, {{feature}}PostInterface
{
    public function __construct(
        protected Model{{feature}} $model
    ) {}

    public function findById(int $id): ?Model{{feature}}
    {
        return $this->model->newQuery()->find($id);
    }

    public function create(array $data): Model{{feature}}
    {
        return $this->model->newQuery()->create($data);
    }

    public function update(int $id, array $data): bool
    {
        return (bool) $this->model->newQuery()->findOrFail($id)->update($data);
    }

    public function delete(int $id): bool
    {
        return (bool) $this->model->newQuery()->findOrFail($id)->delete();
    }
}
